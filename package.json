{
  "name": "cardtape",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "NITRO_PRESET=vercel vite build && node scripts/prerender-vercel.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx apps/indexer/src/migrate.ts",
    "db:local:start": "bash scripts/local-postgres.sh start",
    "db:local:stop": "bash scripts/local-postgres.sh stop",
    "db:local:status": "bash scripts/local-postgres.sh status",
    "seed": "tsx apps/indexer/src/seed.ts",
    "seed:dry": "tsx apps/indexer/src/seed.ts --dry-run",
    "estimate": "tsx apps/indexer/src/estimate.ts",
    "indexer": "tsx apps/indexer/src/index.ts",
    "audit:optimism": "tsx apps/indexer/src/audit-optimism.ts",
    "backfill:optimism": "tsx apps/indexer/src/backfill-optimism.ts",
    "snapshot:bootstrap": "tsx apps/indexer/src/bootstrap-snapshot-state.ts",
    "snapshot:init:rpc": "tsx apps/indexer/src/init-snapshot-state-from-rpc.ts",
    "snapshot:generate": "tsx apps/indexer/src/update-snapshot.ts",
    "snapshot:generate:from-db": "tsx apps/indexer/src/publish-snapshot.ts",
    "indexer:once": "tsx apps/indexer/src/index.ts --once",
    "indexer:catchup": "tsx apps/indexer/src/index.ts --max-batches 20",
    "tiers:reconstruct": "tsx apps/indexer/src/reconstruct-tiers.ts",
    "tape": "tsx apps/indexer/src/tape-server.ts",
    "tape:dev": "tsx apps/indexer/src/tape-server.ts --replay 8",
    "tape:stress": "tsx apps/indexer/src/tape-stress.ts",
    "lint": "oxlint app packages apps tests drizzle.config.ts vitest.config.ts",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "nitro": "^3.0.260903-beta",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "viem": "^2.56.7",
    "vinext": "1.0.0-beta.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.0.1",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
